# Copy to .env.local (dev) or .env (docker compose). Never commit real values.

# --- Required -------------------------------------------------------------
# Must be a replica set (transactions). Local: run start-mongodb.bat; Atlas clusters already are.
MONGODB_URI=mongodb://127.0.0.1:27017/trackit?replicaSet=rs0
# openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# --- Background jobs / scheduler -----------------------------------------
# Bearer token for /api/internal/* (cron). openssl rand -hex 24
CRON_SECRET=

# --- Scaling knobs (optional) --------------------------------------------
# Shared cache + rate limits across instances. Unset = in-process memory cache.
# REDIS_URL=redis://localhost:6379
# Offload analytics/list reads to replicas: primary | secondaryPreferred | nearest
MONGODB_READ_PREFERENCE=primary
# Per server instance. On Vercel/serverless use 5 so many instances stay under Atlas connection limits.
MONGODB_MAX_POOL_SIZE=20
# Indexes are built on startup by default (safe; existing indexes are a no-op).
# For very large collections set false and run POST /api/internal/db-indexes during deploys.
# MONGODB_AUTO_INDEX=false

# --- Notifications --------------------------------------------------------
# console = emails (incl. password-reset links) are written to the server log. Use resend in production.
NOTIFIER=console            # console | resend
# RESEND_API_KEY=
NOTIFY_FROM="TrackIt <alerts@your-domain.com>"
# Receives contact-form messages; also shown as the contact address on /privacy and /terms.
SUPPORT_EMAIL=support@your-domain.com

# --- Behaviour ------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
ALLOW_ADMIN_SIGNUP=true     # false = invite-only store admins during the pilot
# true = users must confirm their email before signing in (requires NOTIFIER=resend)
REQUIRE_EMAIL_VERIFICATION=false
LOG_LEVEL=info

# --- Legal pages ----------------------------------------------------------
# Name shown as the operator on /privacy and /terms (read at build time).
# LEGAL_ENTITY_NAME="Your Company Pvt Ltd"
# LEGAL_LAST_UPDATED="11 November 2026"

# --- Error tracking (optional) -------------------------------------------
# Sentry project DSN. Unset = disabled.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
